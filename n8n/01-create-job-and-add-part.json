      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "notes": "Edit baseUrl (no trailing slash) and apiKey (STOCK_API_KEY; JOBS_API_KEY if you set one) before running. Use a quantity larger than the stock on hand to see a shortfall Draft order.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.baseUrl }}/jobs-api/jobs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Config').item.json.apiKey }}"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jobDate: $now.toFormat('yyyy-MM-dd'), client: $('Config').item.json.client, clientAddress: $('Config').item.json.clientAddress, description: $('Config').item.json.jobDescription }) }}"
      },
      "id": "eb0af1f5-20de-5270-87fc-a17d80d460ce",
      "name": "Create Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.baseUrl }}/jobs-api/job/{{ $('Create Job').item.json.jobId }}/parts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Config').item.json.apiKey }}"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ partNumber: $('Config').item.json.partNumber, quantity: $('Config').item.json.quantity }) }}"
      },
      "id": "7697cda9-b4ab-52a5-9a5e-a9829911d055",
