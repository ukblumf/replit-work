        "sendHeaders": true,
        "parametersHeaders": {
          "values": [
            {
              "name": "Authorization",
              "valueProvider": "fieldValue",
              "value": "={{ 'Bearer ' + $('Config').item.json.apiKey }}"
            }
          ]
        },
        "placeholderDefinitions": {
          "values": [
            {
              "name": "partNumber",
              "description": "Part of a part number to search for",
              "type": "string"
            }
          ]
        }
      },
