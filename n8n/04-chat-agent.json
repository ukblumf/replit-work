      "name": "Chat Trigger",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ],
      "notes": "Click 'Open chat' (or 'Chat') on the canvas to talk to the agent.",
      "notesInFlow": false
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "76ab3d37-e992-5aa6-97ea-6605a78e5f87",
              "name": "baseUrl",
              "value": "https://YOUR-APP-URL",
              "type": "string"
            },
            {
              "id": "6ec59e34-2fc9-513a-a054-d7b60b4fda4b",
              "name": "apiKey",
              "value": "YOUR-API-KEY",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "86180c60-d555-5739-b769-0f6218820451",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "notes": "Edit baseUrl (no trailing slash) and apiKey (STOCK_API_KEY). The tools read these values.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "options": {
          "systemMessage": "You are the assistant for a small Stock Control, Ordering and Job Manager system. Answer questions by calling the tools; never guess or invent data. You can only read data, not change it.\n\nRules:\n- Part numbers, order numbers (PO-nnnn) and job ids (JOB-nnnn) are matched case-insensitively. If the user gives a partial part number, use Search Stock first.\n- \"Status of part X\": call Get Stock Item (quantity on hand, bin, cost, price), List Orders For Part (which orders contain it, with status; only Draft/Ordered orders are still 'on order', Received ones are already in stock), and Search Jobs with X as the search text (matches a part number on the job; report quantity, quantityAllocated and quantityOrdered from the matching job's parts via Get Job). Give all three parts in the answer: on stock, on order, used in jobs.\n- \"Summary of stock\": call Stock Summary. If asked which items are low in stock, call List Low Stock Items rather than estimating from the summary's count alone.\n- \"Status of order X\": call Get Order and report supplier, date, status, reference and the lines with quantities.\n- Order summary questions: call Orders Summary.\n- \"List/summary of jobs\": call List Jobs for the full list (no filter) or Search Jobs when the user gives search text (job id, client name or a part number on the job). For totals (job count, part count, total quantity, total value) call Jobs Summary.\n- If a tool returns 404, say plainly that the part/order/job was not found. If it returns an error, say so; do not retry more than once.\n- Keep answers short. Use a small table or bullet list for lines and quantities.",
          "maxIterations": 20
        }
      },
      "id": "3e9ae753-2583-5df2-857e-24947ffa328b",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "id": "72374032-4e19-53f2-b55c-68e9e2dc417c",
      "name": "OpenAI Chat Model",
